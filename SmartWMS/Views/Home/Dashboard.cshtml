@model DashboardVm
@{
  ViewData["Title"] = "Dashboard Pergudangan";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1" style="letter-spacing: -0.03em;">Dashboard Gudang Finished Goods</h3>
    <p class="text-muted mb-0 small"><i class="bi bi-clock-history me-1"></i> Pemantauan Okupansi Rak, Kontrol Kualitas Kimia Baterai, &amp; Dispatch Real-Time</p>
  </div>
  <div class="d-flex gap-2">
    <a asp-controller="Storing" asp-action="Create" class="btn btn-outline-primary btn-sm px-3 d-flex align-items-center gap-1">
      <i class="bi bi-plus-circle"></i> Input Storing
    </a>
    <a asp-controller="Dispatch" asp-action="Create" class="btn btn-primary btn-sm px-3 d-flex align-items-center gap-1">
      <i class="bi bi-truck"></i> Buat DO Baru
    </a>
  </div>
</div>

<!-- 4 KPI CARDS -->
<div class="row g-3 mb-4">
  <div class="col-6 col-xl-3">
    <div class="metric-card primary">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="metric-title">Total Kapasitas</div>
          <div class="metric-value">@Model.TotalCapacity.ToString("N0")</div>
          <div class="small text-muted mt-2"><i class="bi bi-layers me-1"></i> Total Slot Rak &amp; Lantai</div>
        </div>
        <div class="metric-icon-wrap primary">
          <i class="bi bi-building"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-xl-3">
    <div class="metric-card success">
      <div class="d-flex justify-content-between align-items-start">
        <div class="w-100 me-2">
          <div class="metric-title">Keterisian Gudang</div>
          <div class="metric-value">@Model.OccupancyPct%</div>
          <div class="progress mt-2" style="height: 6px; border-radius: 9999px; background: #e2e8f0;">
            <div class="progress-bar bg-success" style="width: @Model.OccupancyPct.ToString(System.Globalization.CultureInfo.InvariantCulture)%;"></div>
          </div>
          <div class="small text-muted mt-2"><i class="bi bi-box-seam me-1"></i> @Model.TotalQty.ToString("N0") unit tersimpan</div>
        </div>
        <div class="metric-icon-wrap success">
          <i class="bi bi-pie-chart-fill"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-xl-3">
    <div class="metric-card warning">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="metric-title">Lot Aging Alert</div>
          <div class="metric-value text-warning">@Model.AgingCount</div>
          <div class="small text-muted mt-2"><i class="bi bi-shield-exclamation me-1"></i> Simpan &gt; 90 hari (Perlu Cas)</div>
        </div>
        <div class="metric-icon-wrap warning">
          <i class="bi bi-battery-charging"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="col-6 col-xl-3">
    <div class="metric-card info">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="metric-title">DO Ritase Hari Ini</div>
          <div class="metric-value text-primary">@Model.TodayDoCount</div>
          <div class="small text-muted mt-2"><i class="bi bi-calendar-check me-1"></i> Pengiriman aktif terdaftar</div>
        </div>
        <div class="metric-icon-wrap info">
          <i class="bi bi-truck-front-fill"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- WAREHOUSE GRID & CHART -->
<div class="row g-4">
  <div class="col-lg-8">
    <div class="modern-card h-100">
      <div class="card-header-clean">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-grid-3x3 text-primary"></i>
          <span>Status Grid Gudang (Floor &amp; Racks)</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <span class="status-pill safe"><i class="bi bi-check-circle-fill text-success"></i> Aman (&lt;80%)</span>
          <span class="status-pill warning"><i class="bi bi-exclamation-triangle-fill text-warning"></i> Padat (&ge;80%)</span>
          <span class="status-pill danger"><i class="bi bi-exclamation-octagon-fill text-danger"></i> Aging / Drop V</span>
        </div>
      </div>
      <div class="p-3 p-md-4">
        <div class="row g-3">
          @foreach (var t in Model.Tiles)
          {
            var statusClass = t.Color == "danger" ? "status-danger" : t.Color == "warning" ? "status-warning" : "status-safe";
            var pct = t.Max > 0 ? (t.Qty * 100 / t.Max) : 0;
            var barColor = t.Color == "danger" ? "bg-danger" : t.Color == "warning" ? "bg-warning" : "bg-success";

            <div class="col-6 col-md-4 col-xl-3">
              <div class="rack-tile @statusClass">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <span class="rack-code">@t.Code</span>
                  <span class="rack-zone-badge @(t.Zone == "RACK" ? "zone-rack" : "zone-floor")">@t.Zone</span>
                </div>
                
                <div class="rack-progress-wrap">
                  <div class="d-flex justify-content-between rack-qty-text mb-1">
                    <span>@t.Qty <small class="text-muted">/ @t.Max</small></span>
                    <span class="fw-bold">@pct%</span>
                  </div>
                  <div class="progress" style="height: 5px; border-radius: 9999px; background: #e2e8f0;">
                    <div class="progress-bar @barColor" style="width: @pct%;"></div>
                  </div>
                </div>

                <div class="mt-2 text-end">
                  @if (t.Color == "danger")
                  {
                    <span class="status-pill danger"><i class="bi bi-exclamation-circle-fill"></i> Kritis</span>
                  }
                  else if (t.Color == "warning")
                  {
                    <span class="status-pill warning"><i class="bi bi-dash-circle-fill"></i> Padat</span>
                  }
                  else
                  {
                    <span class="status-pill safe"><i class="bi bi-check-circle-fill"></i> Normal</span>
                  }
                </div>
              </div>
            </div>
          }
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="modern-card h-100">
      <div class="card-header-clean">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-pie-chart text-primary"></i>
          <span>Komposisi Mutu Stok</span>
        </div>
      </div>
      <div class="p-3 p-md-4 d-flex flex-column justify-content-between">
        <div style="position: relative; height: 230px;" class="mb-4">
          <canvas id="donut"></canvas>
        </div>
        
        <div class="bg-light p-3 rounded-3 border">
          <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
            <span class="small fw-semibold text-muted d-flex align-items-center gap-2">
              <span style="width: 10px; height: 10px; border-radius: 50%; background-color: #10b981; display: inline-block;"></span> Normal
            </span>
            <span class="fw-bold fs-6">@Model.Normal.ToString("N0") <small class="text-muted fw-normal">unit</small></span>
          </div>
          <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
            <span class="small fw-semibold text-muted d-flex align-items-center gap-2">
              <span style="width: 10px; height: 10px; border-radius: 50%; background-color: #f59e0b; display: inline-block;"></span> Aging Alert (&gt;90d)
            </span>
            <span class="fw-bold fs-6 text-warning">@Model.Aging.ToString("N0") <small class="text-muted fw-normal">unit</small></span>
          </div>
          <div class="d-flex justify-content-between align-items-center py-1">
            <span class="small fw-semibold text-muted d-flex align-items-center gap-2">
              <span style="width: 10px; height: 10px; border-radius: 50%; background-color: #ef4444; display: inline-block;"></span> Low Voltage (&lt;12.4V)
            </span>
            <span class="fw-bold fs-6 text-danger">@Model.LowVoltage.ToString("N0") <small class="text-muted fw-normal">unit</small></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
  const ctx = document.getElementById('donut').getContext('2d');
  new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: ['Normal', 'Aging Alert', 'Low Voltage'],
      datasets: [{
        data: [@Model.Normal, @Model.Aging, @Model.LowVoltage],
        backgroundColor: ['#10b981', '#f59e0b', '#ef4444'],
        borderWidth: 2,
        borderColor: '#ffffff',
        hoverOffset: 6
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              const total = @(Model.Normal + Model.Aging + Model.LowVoltage);
              const val = context.raw;
              const pct = total > 0 ? Math.round((val / total) * 100) : 0;
              return `${context.label}: ${val} unit (${pct}%)`;
            }
          }
        }
      },
      cutout: '72%'
    }
  });
</script>
}
