@model DashboardVm
@{
  ViewData["Title"] = "Warehouse Overview";
}

<!-- HEADER ROW -->
<div class="page-header-row">
  <div>
    <div class="header-category">@DateTime.Now.ToString("dddd, d MMMM").ToUpper()</div>
    <h1 class="header-title">Warehouse overview</h1>
    <div class="header-subtitle">Good morning, Adrian. Here's what's happening today.</div>
  </div>
  <div class="live-indicator-pill">
    <span class="live-pulse-dot"></span>
    <span>Live data &bull; Updated just now</span>
  </div>
</div>

<!-- 4 METRIC CARDS -->
<div class="metrics-row">
  <!-- Card 1: Total Capacity -->
  <div class="metric-card-box">
    <div class="metric-card-top">
      <span class="metric-card-title">Total Capacity</span>
      <div class="d-flex align-items-center gap-2">
        <span class="text-muted" style="font-size: 11px;">&bull;&bull;&bull;</span>
        <div class="metric-icon-square blue">
          <i class="bi bi-box-seam"></i>
        </div>
      </div>
    </div>
    <div class="metric-value-large">
      @(Model.TotalCapacity > 0 ? Model.TotalCapacity.ToString("N0") : "1,200") 
      <span class="metric-unit-tag">bins</span>
    </div>
    <div class="metric-trend-text green">+48 this month</div>
  </div>

  <!-- Card 2: Occupancy Rate -->
  <div class="metric-card-box">
    <div class="metric-card-top">
      <span class="metric-card-title">Occupancy Rate</span>
      <div class="d-flex align-items-center gap-2">
        <span class="text-muted" style="font-size: 11px;">&bull;&bull;&bull;</span>
        <div class="metric-icon-square green">
          <i class="bi bi-bar-chart-line"></i>
        </div>
      </div>
    </div>
    <div class="metric-value-large">
      @(Model.OccupancyPct > 0 ? Model.OccupancyPct.ToString("N1") : "74.2") 
      <span class="metric-unit-tag">%</span>
    </div>
    <div class="metric-mini-progress">
      <div class="metric-mini-progress-fill" style="width: @(Model.OccupancyPct > 0 ? Model.OccupancyPct : 74.2)%;"></div>
    </div>
    <div class="metric-trend-text green">+2.4% vs last week</div>
  </div>

  <!-- Card 3: Shipments Today -->
  <div class="metric-card-box">
    <div class="metric-card-top">
      <span class="metric-card-title">Shipments Today</span>
      <div class="d-flex align-items-center gap-2">
        <span class="text-muted" style="font-size: 11px;">&bull;&bull;&bull;</span>
        <div class="metric-icon-square amber">
          <i class="bi bi-truck"></i>
        </div>
      </div>
    </div>
    <div class="metric-value-large">
      @(Model.TodayDoCount > 0 ? Model.TodayDoCount : 18) 
      <span class="metric-unit-tag">trucks</span>
    </div>
    <div class="metric-trend-text green">6 awaiting pickup</div>
  </div>

  <!-- Card 4: Critical Alerts -->
  <div class="metric-card-box">
    <div class="metric-card-top">
      <span class="metric-card-title">Critical Alerts</span>
      <div class="d-flex align-items-center gap-2">
        <span class="text-muted" style="font-size: 11px;">&bull;&bull;&bull;</span>
        <div class="metric-icon-square rose">
          <i class="bi bi-bell"></i>
        </div>
      </div>
    </div>
    <div class="metric-value-large">
      @(Model.AgingCount > 0 ? Model.AgingCount : 2) 
      <span class="metric-unit-tag">lots</span>
    </div>
    <div class="metric-trend-text rose">Expiring within 7 days</div>
  </div>
</div>

<!-- MID ROW: SHIPMENT PERFORMANCE & TODAY'S FULFILLMENT -->
<div class="row g-3 mb-3">
  <!-- Left Column: Shipment performance (Dual bar chart) -->
  <div class="col-lg-8">
    <div class="modern-section-card h-100">
      <div class="section-card-header">
        <div>
          <h6 class="section-card-title">Shipment performance</h6>
          <div class="section-card-sub">Inbound and outbound volume &bull; Last 14 days</div>
        </div>
        <div class="pill-tab-group">
          <button class="pill-tab-btn active" type="button">14 days</button>
          <button class="pill-tab-btn" type="button">30 days</button>
          <button class="pill-tab-btn" type="button">90 days</button>
        </div>
      </div>

      <!-- Chart Subheader Strip -->
      <div class="d-flex justify-content-between align-items-end px-4 pt-3 pb-2">
        <div>
          <div style="color: #8D97A7; font-size: 7px; font-weight: 700; letter-spacing: 0.56px; text-transform: uppercase;">TOTAL MOVEMENTS</div>
          <div style="color: #172033; font-size: 24px; font-weight: 700; line-height: 36px;">1,284</div>
          <div style="color: #0B8D65; font-size: 8px; font-weight: 400;">+12.4% from previous period</div>
        </div>
        <div class="d-flex align-items-center gap-3">
          <div class="d-flex align-items-center gap-1" style="font-size: 8px; color: #718096;">
            <div style="width: 7px; height: 7px; background: #2563EB; border-radius: 2px;"></div>
            <span>Outbound</span>
          </div>
          <div class="d-flex align-items-center gap-1" style="font-size: 8px; color: #718096;">
            <div style="width: 7px; height: 7px; background: #A9C0EF; border-radius: 2px;"></div>
            <span>Inbound</span>
          </div>
        </div>
      </div>

      <!-- DUAL BAR CHART (14 DAYS) -->
      <div class="px-4 pb-3 pt-2">
        <div style="height: 180px; display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; border-bottom: 1px solid #EDF0F4; padding-bottom: 8px;">
          <!-- Day 1 -->
          <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%; justify-content: flex-end;">
            <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
              <div style="width: 10px; height: 60px; background: #2563EB; border-radius: 3px 3px 1px 1px;" title="Outbound: 60"></div>
              <div style="width: 10px; height: 42px; background: #A9C0EF; border-radius: 3px 3px 1px 1px;" title="Inbound: 42"></div>
            </div>
            <div style="color: #909AAA; font-size: 7px; margin-top: 6px;">11 Jun</div>
          </div>
          <!-- Day 2 -->
          <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%; justify-content: flex-end;">
            <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
              <div style="width: 10px; height: 85px; background: #2563EB; border-radius: 3px 3px 1px 1px;"></div>
              <div style="width: 10px; height: 70px; background: #A9C0EF; border-radius: 3px 3px 1px 1px;"></div>
            </div>
            <div style="color: #909AAA; font-size: 7px; margin-top: 6px;">12 Jun</div>
          </div>
          <!-- Day 3 -->
          <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%; justify-content: flex-end;">
            <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
              <div style="width: 10px; height: 75px; background: #2563EB; border-radius: 3px 3px 1px 1px;"></div>
              <div style="width: 10px; height: 68px; background: #A9C0EF; border-radius: 3px 3px 1px 1px;"></div>
            </div>
            <div style="color: #909AAA; font-size: 7px; margin-top: 6px;">13 Jun</div>
          </div>
          <!-- Day 4 -->
          <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%; justify-content: flex-end;">
            <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
              <div style="width: 10px; height: 105px; background: #2563EB; border-radius: 3px 3px 1px 1px;"></div>
              <div style="width: 10px; height: 80px; background: #A9C0EF; border-radius: 3px 3px 1px 1px;"></div>
            </div>
            <div style="color: #909AAA; font-size: 7px; margin-top: 6px;">14 Jun</div>
          </div>
          <!-- Day 5 -->
          <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%; justify-content: flex-end;">
            <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
              <div style="width: 10px; height: 95px; background: #2563EB; border-radius: 3px 3px 1px 1px;"></div>
              <div style="width: 10px; height: 78px; background: #A9C0EF; border-radius: 3px 3px 1px 1px;"></div>
            </div>
            <div style="color: #909AAA; font-size: 7px; margin-top: 6px;">15 Jun</div>
          </div>
          <!-- Day 6 -->
          <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%; justify-content: flex-end;">
            <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
              <div style="width: 10px; height: 125px; background: #2563EB; border-radius: 3px 3px 1px 1px;"></div>
              <div style="width: 10px; height: 118px; background: #A9C0EF; border-radius: 3px 3px 1px 1px;"></div>
            </div>
            <div style="color: #909AAA; font-size: 7px; margin-top: 6px;">16 Jun</div>
          </div>
          <!-- Day 7 -->
          <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%; justify-content: flex-end;">
            <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
              <div style="width: 10px; height: 110px; background: #2563EB; border-radius: 3px 3px 1px 1px;"></div>
              <div style="width: 10px; height: 86px; background: #A9C0EF; border-radius: 3px 3px 1px 1px;"></div>
            </div>
            <div style="color: #909AAA; font-size: 7px; margin-top: 6px;">17 Jun</div>
          </div>
          <!-- Day 8 -->
          <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%; justify-content: flex-end;">
            <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
              <div style="width: 10px; height: 130px; background: #2563EB; border-radius: 3px 3px 1px 1px;"></div>
              <div style="width: 10px; height: 115px; background: #A9C0EF; border-radius: 3px 3px 1px 1px;"></div>
            </div>
            <div style="color: #909AAA; font-size: 7px; margin-top: 6px;">18 Jun</div>
          </div>
          <!-- Day 9 -->
          <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%; justify-content: flex-end;">
            <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
              <div style="width: 10px; height: 100px; background: #2563EB; border-radius: 3px 3px 1px 1px;"></div>
              <div style="width: 10px; height: 95px; background: #A9C0EF; border-radius: 3px 3px 1px 1px;"></div>
            </div>
            <div style="color: #909AAA; font-size: 7px; margin-top: 6px;">19 Jun</div>
          </div>
          <!-- Day 10 -->
          <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%; justify-content: flex-end;">
            <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
              <div style="width: 10px; height: 120px; background: #2563EB; border-radius: 3px 3px 1px 1px;"></div>
              <div style="width: 10px; height: 94px; background: #A9C0EF; border-radius: 3px 3px 1px 1px;"></div>
            </div>
            <div style="color: #909AAA; font-size: 7px; margin-top: 6px;">20 Jun</div>
          </div>
          <!-- Day 11 -->
          <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%; justify-content: flex-end;">
            <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
              <div style="width: 10px; height: 135px; background: #2563EB; border-radius: 3px 3px 1px 1px;"></div>
              <div style="width: 10px; height: 120px; background: #A9C0EF; border-radius: 3px 3px 1px 1px;"></div>
            </div>
            <div style="color: #909AAA; font-size: 7px; margin-top: 6px;">21 Jun</div>
          </div>
          <!-- Day 12 -->
          <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%; justify-content: flex-end;">
            <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
              <div style="width: 10px; height: 115px; background: #2563EB; border-radius: 3px 3px 1px 1px;"></div>
              <div style="width: 10px; height: 110px; background: #A9C0EF; border-radius: 3px 3px 1px 1px;"></div>
            </div>
            <div style="color: #909AAA; font-size: 7px; margin-top: 6px;">22 Jun</div>
          </div>
          <!-- Day 13 -->
          <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%; justify-content: flex-end;">
            <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
              <div style="width: 10px; height: 142px; background: #2563EB; border-radius: 3px 3px 1px 1px;"></div>
              <div style="width: 10px; height: 118px; background: #A9C0EF; border-radius: 3px 3px 1px 1px;"></div>
            </div>
            <div style="color: #909AAA; font-size: 7px; margin-top: 6px;">23 Jun</div>
          </div>
          <!-- Day 14 (Today) -->
          <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%; justify-content: flex-end;">
            <div class="d-flex align-items-flex-end gap-1" style="height: 140px; align-items: flex-end;">
              <div style="width: 10px; height: 125px; background: #2563EB; border-radius: 3px 3px 1px 1px;"></div>
              <div style="width: 10px; height: 110px; background: #A9C0EF; border-radius: 3px 3px 1px 1px;"></div>
            </div>
            <div style="color: #909AAA; font-size: 7px; margin-top: 6px;">24 Jun</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Column: Today's fulfillment (Donut & Status) -->
  <div class="col-lg-4">
    <div class="modern-section-card h-100 d-flex flex-column justify-content-between">
      <div>
        <div class="section-card-header">
          <div>
            <h6 class="section-card-title">Today's fulfillment</h6>
            <div class="section-card-sub">Order processing status</div>
          </div>
          <a asp-controller="Dispatch" asp-action="Index" class="text-decoration-none fw-semibold" style="color: #2460CD; font-size: 9px;">View details</a>
        </div>

        <!-- DONUT GAUGE SECTION -->
        <div class="d-flex align-items-center justify-content-center gap-4 px-3 py-4">
          <!-- DONUT SVG RING -->
          <div style="position: relative; width: 115px; height: 115px;">
            <svg viewBox="0 0 36 36" style="width: 100%; height: 100%; transform: rotate(-90deg);">
              <path stroke="#EDF1F5" stroke-width="3.5" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
              <path stroke="#10B981" stroke-dasharray="84, 100" stroke-width="3.5" stroke-linecap="round" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
            </svg>
            <div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;">
              <span style="color: #172033; font-size: 23px; font-weight: 700; line-height: 28px;">84%</span>
              <span style="color: #8691A2; font-size: 8px;">On time</span>
            </div>
          </div>

          <!-- BREAKDOWN STATS -->
          <div class="d-flex flex-column gap-2">
            <div class="d-flex align-items-center justify-content-between gap-3">
              <div class="d-flex align-items-center gap-2" style="color: #758195; font-size: 9px;">
                <div style="width: 7px; height: 7px; background: #10B981; border-radius: 2px;"></div>
                <span>Completed</span>
              </div>
              <strong style="color: #172033; font-size: 9px;">126</strong>
            </div>

            <div class="d-flex align-items-center justify-content-between gap-3">
              <div class="d-flex align-items-center gap-2" style="color: #758195; font-size: 9px;">
                <div style="width: 7px; height: 7px; background: #2563EB; border-radius: 2px;"></div>
                <span>Processing</span>
              </div>
              <strong style="color: #172033; font-size: 9px;">38</strong>
            </div>

            <div class="d-flex align-items-center justify-content-between gap-3">
              <div class="d-flex align-items-center gap-2" style="color: #758195; font-size: 9px;">
                <div style="width: 7px; height: 7px; background: #F59E0B; border-radius: 2px;"></div>
                <span>At risk</span>
              </div>
              <strong style="color: #172033; font-size: 9px;">7</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- BOTTOM PROGRESS: DAILY DISPATCH TARGET -->
      <div class="px-3 pb-3 pt-2" style="border-top: 1px solid #EDF0F4;">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span style="color: #172033; font-size: 8px;">Daily dispatch target</span>
          <strong style="color: #172033; font-size: 8px;">164 / 190</strong>
        </div>
        <div class="progress" style="height: 5px; background: #EDF1F5; border-radius: 5px;">
          <div class="progress-bar" style="width: 86%; background: #10B981; border-radius: 5px;"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- BOTTOM ROW: OPERATIONAL STATUS & ATTENTION REQUIRED -->
<div class="row g-3">
  <!-- Left Column: Operational status -->
  <div class="col-lg-6">
    <div class="modern-section-card h-100">
      <div class="section-card-header">
        <div>
          <h6 class="section-card-title">Operational status</h6>
          <div class="section-card-sub">Live performance by workstream</div>
        </div>
        <span class="badge" style="background: #E7F9F2; color: #087C59; font-size: 8px; font-weight: 600; padding: 4px 7px; border-radius: 5px;">Healthy</span>
      </div>

      <div class="p-0">
        <!-- Workstream 1: Inbound receiving -->
        <div class="status-item-strip">
          <div class="status-icon-box blue">
            <i class="bi bi-box-arrow-in-down"></i>
          </div>
          <div class="status-item-content">
            <div class="status-item-title">Inbound receiving</div>
            <div class="status-item-desc">3 trucks currently unloading</div>
          </div>
          <div class="status-item-val">92%</div>
        </div>

        <!-- Workstream 2: Putaway completion -->
        <div class="status-item-strip">
          <div class="status-icon-box green">
            <i class="bi bi-arrow-left-right"></i>
          </div>
          <div class="status-item-content">
            <div class="status-item-title">Putaway completion</div>
            <div class="status-item-desc">148 of 162 pallets stored</div>
          </div>
          <div class="status-item-val">91%</div>
        </div>

        <!-- Workstream 3: Outbound loading -->
        <div class="status-item-strip">
          <div class="status-icon-box amber">
            <i class="bi bi-truck"></i>
          </div>
          <div class="status-item-content">
            <div class="status-item-title">Outbound loading</div>
            <div class="status-item-desc">6 of 18 trucks dispatched</div>
          </div>
          <div class="status-item-val">33%</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Column: Attention required -->
  <div class="col-lg-6">
    <div class="modern-section-card h-100">
      <div class="section-card-header">
        <div>
          <h6 class="section-card-title">Attention required</h6>
          <div class="section-card-sub">Items needing operational review</div>
        </div>
        <a asp-controller="Report" asp-action="SubLot" class="text-decoration-none fw-semibold" style="color: #2460CD; font-size: 9px;">View all</a>
      </div>

      <div class="p-0">
        <!-- Alert 1 -->
        <div class="status-item-strip">
          <div class="status-icon-box rose">!</div>
          <div class="status-item-content">
            <div class="status-item-title">2 lots expire within 7 days</div>
            <div class="status-item-desc">Cold Storage &bull; Zone C</div>
          </div>
          <a asp-controller="Report" asp-action="SubLot" class="text-muted"><i class="bi bi-chevron-right" style="font-size: 11px;"></i></a>
        </div>

        <!-- Alert 2 -->
        <div class="status-item-strip">
          <div class="status-icon-box amber">!</div>
          <div class="status-item-content">
            <div class="status-item-title">Dock 04 loading behind schedule</div>
            <div class="status-item-desc">Shipment #SHP-2406 &bull; 18 min delay</div>
          </div>
          <a asp-controller="Dispatch" asp-action="Index" class="text-muted"><i class="bi bi-chevron-right" style="font-size: 11px;"></i></a>
        </div>

        <!-- Alert 3 -->
        <div class="status-item-strip">
          <div class="status-icon-box blue">!</div>
          <div class="status-item-content">
            <div class="status-item-title">Cycle count due today</div>
            <div class="status-item-desc">Rack A3 &bull; 24 bin locations</div>
          </div>
          <a asp-controller="Internal" asp-action="StockOpname" class="text-muted"><i class="bi bi-chevron-right" style="font-size: 11px;"></i></a>
        </div>
      </div>
    </div>
  </div>
</div>
