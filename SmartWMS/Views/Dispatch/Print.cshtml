@model Delivery
@{
  ViewData["Title"] = "Cetak Surat Jalan - " + Model.DONumber;
  Layout = null; // Standalone clean printable document
}
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <title>Surat Jalan @Model.DONumber</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <style>
    body {
      background-color: #f1f5f9;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: #0f172a;
    }
    .print-sheet {
      max-width: 820px;
      margin: 20px auto;
      background: #ffffff;
      padding: 35px 45px;
      border-radius: 8px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }
    .company-logo {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: #0f172a;
    }
    .stamp-verified {
      border: 2px dashed #059669;
      color: #059669;
      font-weight: 800;
      padding: 6px 14px;
      border-radius: 6px;
      display: inline-block;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .table-doc th {
      background-color: #f8fafc;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      border-bottom: 2px solid #0f172a;
    }
    .table-doc td {
      font-size: 0.88rem;
      padding: 8px 10px;
    }
    .sign-box {
      border-top: 1px solid #0f172a;
      width: 140px;
      text-align: center;
      padding-top: 5px;
      font-size: 0.8rem;
      font-weight: 600;
    }
    @@media print {
      body {
        background: #ffffff;
        margin: 0;
        padding: 0;
      }
      .print-sheet {
        box-shadow: none;
        margin: 0;
        max-width: 100%;
        padding: 20px;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body>

<div class="no-print text-center my-3">
  <button onclick="window.print()" class="btn btn-primary px-4 me-2"><i class="bi bi-printer me-1"></i> Cetak Dokumen</button>
  <button onclick="window.close()" class="btn btn-outline-secondary px-3">Tutup Jendela</button>
</div>

<div class="print-sheet">
  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
    <div>
      <div class="company-logo"><i class="bi bi-boxes text-primary me-2"></i>PT CENTURY BATTERIES INDONESIA</div>
      <div class="small text-muted">Kawasan Industri KIIC, Jl. Maligi Raya, Karawang Barat, Jawa Barat</div>
      <div class="small text-muted">Telp: (0267) 845-1234 &middot; Email: dispatch@cbi-battery.com</div>
    </div>
    <div class="text-end">
      <div class="h4 fw-bold mb-1 text-primary">SURAT JALAN</div>
      <div class="small fw-bold">NO: @Model.DONumber</div>
      <div class="mt-2">
        @if (Model.Status == DoStatus.Completed)
        {
          <span class="stamp-verified"><i class="bi bi-patch-check-fill"></i> POKA-YOKE 100% VERIFIED</span>
        }
        else
        {
          <span class="badge bg-secondary">STATUS: @Model.Status</span>
        }
      </div>
    </div>
  </div>

  <!-- METADATA INFO -->
  <div class="row g-2 mb-4 small">
    <div class="col-6">
      <table class="table table-sm table-borderless mb-0">
        <tr><td class="text-muted" style="width: 120px;">Kepada Yth:</td><td class="fw-bold fs-6">@Model.CustomerName</td></tr>
        <tr><td class="text-muted">Alamat Tujuan:</td><td>Pusat Distribusi / Logistik Penerima</td></tr>
        <tr><td class="text-muted">No. Polisi Truk:</td><td>B 9182 UXZ (Ekspedisi Utama)</td></tr>
      </table>
    </div>
    <div class="col-6">
      <table class="table table-sm table-borderless mb-0">
        <tr><td class="text-muted" style="width: 130px;">Tanggal Rencana:</td><td class="fw-semibold">@Model.DeliveryDate.ToString("dd MMMM yyyy")</td></tr>
        <tr><td class="text-muted">Ritase Waktu:</td><td class="fw-semibold">@Model.Ritase</td></tr>
        <tr><td class="text-muted">Waktu Verifikasi:</td><td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td></tr>
      </table>
    </div>
  </div>

  <!-- TABLE ITEMS -->
  <table class="table table-doc table-bordered mb-4">
    <thead>
      <tr>
        <th style="width: 40px;" class="text-center">No</th>
        <th>Part Number (SKU)</th>
        <th>Deskripsi Barang</th>
        <th class="text-center" style="width: 80px;">Satuan</th>
        <th class="text-center" style="width: 100px;">Qty Dipesan</th>
        <th class="text-center" style="width: 100px;">Qty Dimuat</th>
        <th class="text-center" style="width: 110px;">Verifikasi</th>
      </tr>
    </thead>
    <tbody>
      @{ int no = 1; int totReq = 0; int totLoad = 0; }
      @foreach (var x in Model.Details)
      {
        totReq += x.QtyRequested;
        totLoad += x.QtyLoaded;
        var isDone = x.QtyLoaded == x.QtyRequested;
        <tr>
          <td class="text-center">@(no++)</td>
          <td class="fw-bold">@x.Item.PartNumber</td>
          <td>@x.Item.ItemName</td>
          <td class="text-center">@x.Item.UOM</td>
          <td class="text-center fw-semibold">@x.QtyRequested</td>
          <td class="text-center fw-bold @(isDone ? "text-success" : "")">@x.QtyLoaded</td>
          <td class="text-center">
            @if (isDone)
            {
              <span class="badge bg-success-subtle text-success border border-success-subtle">Lolos Scan</span>
            }
            else
            {
              <span class="badge bg-warning-subtle text-warning border">Belum Lengkap</span>
            }
          </td>
        </tr>
      }
    </tbody>
    <tfoot>
      <tr class="fw-bold table-light">
        <td colspan="4" class="text-end">TOTAL UNIT KESELURUHAN:</td>
        <td class="text-center">@totReq</td>
        <td class="text-center text-success">@totLoad</td>
        <td class="text-center small">@(totReq == totLoad ? "Lengkap" : "Selisih")</td>
      </tr>
    </tfoot>
  </table>

  <div class="small text-muted mb-4">
    <strong>Catatan:</strong> Barang telah melalui proses scan barcode verifikasi gate (*Poka-Yoke Zero Misdelivery*). Harap periksa kondisi fisik dus dan segel palet saat barang tiba.
  </div>

  <!-- 4 SIGNATURE BLOCKS -->
  <div class="d-flex justify-content-between text-center pt-2" style="margin-top: 45px;">
    <div>
      <div style="height: 60px;"></div>
      <div class="sign-box">( Admin Logistik )</div>
      <div class="text-muted" style="font-size: 0.72rem;">Yang Membuat</div>
    </div>
    <div>
      <div style="height: 60px;"></div>
      <div class="sign-box">( Security Gate )</div>
      <div class="text-muted" style="font-size: 0.72rem;">Pemeriksa Pintu Keluar</div>
    </div>
    <div>
      <div style="height: 60px;"></div>
      <div class="sign-box">( Pengemudi / Supir )</div>
      <div class="text-muted" style="font-size: 0.72rem;">Pembawa Barang</div>
    </div>
    <div>
      <div style="height: 60px;"></div>
      <div class="sign-box">( Penerima Barang )</div>
      <div class="text-muted" style="font-size: 0.72rem;">Tanda Tangan &amp; Cap Toko</div>
    </div>
  </div>
</div>

</body>
</html>
