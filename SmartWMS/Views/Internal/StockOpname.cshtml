@model StockOpnameVm
@{
  ViewData["Title"] = "Stock Opname & Cycle Counting";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
  <div>
    <h3 class="fw-bold mb-1" style="letter-spacing: -0.03em;">Stock Opname &amp; Rekonsiliasi (Cycle Counting)</h3>
    <p class="text-muted mb-0 small"><i class="bi bi-clipboard-check me-1"></i> Pencocokan Stok Fisik vs Sistem, Perhitungan Selisih (Variance), &amp; Jurnal Penyesuaian</p>
  </div>
  <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 d-flex align-items-center gap-1">
    <i class="bi bi-arrow-left"></i> Kembali ke Dashboard
  </a>
</div>

@if (TempData["Error"] is string err)
{
  <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 12px;">
    <i class="bi bi-exclamation-triangle-fill me-2"></i> @err
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
}

<!-- FILTER LOKASI -->
<div class="modern-card mb-4">
  <div class="p-3">
    <form method="get" class="row g-2 align-items-end">
      <div class="col-md-5">
        <label class="form-label small text-muted mb-1">Pilih Lokasi Rak yang Sedang Dihitung Fisik</label>
        <select name="location" class="form-select" onchange="this.form.submit()">
          <option value="">-- Semua Lokasi Rak / Lantai --</option>
          @foreach (var l in Model.Locations)
          {
            <option value="@l.LocationCode" selected="@(Model.SelectedLocation == l.LocationCode)">
              @l.LocationCode (@l.ZoneType) &mdash; Terisi @l.CurrentQty / @l.MaxCapacity unit
            </option>
          }
        </select>
      </div>
      <div class="col-md-7 text-md-end text-muted small">
        <i class="bi bi-info-circle me-1"></i> Masukkan jumlah fisik aktual di kolom "Fisik Terhitung", lalu klik Rekonsiliasi.
      </div>
    </form>
  </div>
</div>

<!-- OPNAME TABLE -->
<div class="modern-card">
  <div class="card-header-clean py-2 px-3">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-check2-square text-primary"></i>
      <span class="fs-6">Daftar Stok Siap Dihitung Fisik</span>
    </div>
    <span class="badge bg-light text-dark border">@Model.Balances.Count Lot Terdaftar</span>
  </div>

  <div class="table-responsive">
    <table class="table table-modern align-middle mb-0">
      <thead>
        <tr>
          <th>Lokasi Slot</th>
          <th>Part SKU</th>
          <th>Nama Item</th>
          <th>Nomor Lot</th>
          <th>Stok Sistem</th>
          <th style="min-width: 320px;">Penyesuaian Fisik Aktual &amp; Alasan</th>
        </tr>
      </thead>
      <tbody>
        @if (!Model.Balances.Any())
        {
          <tr>
            <td colspan="6" class="text-center py-5 text-muted">
              <i class="bi bi-inbox fs-1 mb-2"></i>
              <div>Tidak ada stok fisik di lokasi ini.</div>
            </td>
          </tr>
        }
        @foreach (var b in Model.Balances)
        {
          <tr>
            <td>
              <span class="badge bg-light text-dark border fw-bold fs-6">
                <i class="bi bi-geo-alt-fill text-primary"></i> @b.Location.LocationCode
              </span>
            </td>
            <td>
              <code class="px-2 py-1 bg-light text-primary rounded border fw-bold">@b.Item.PartNumber</code>
            </td>
            <td>
              <span class="fw-semibold">@b.Item.ItemName</span>
            </td>
            <td>
              <code class="px-2 py-1 bg-light text-dark rounded border">@b.LotNumber</code>
            </td>
            <td>
              <span class="fs-5 fw-bold text-dark">@b.Quantity</span>
              <small class="text-muted">unit</small>
            </td>
            <td>
              <form asp-action="SubmitOpname" method="post" class="d-flex align-items-center gap-2" onsubmit="return confirm('Konfirmasi penyesuaian stok opname? Data akan tercatat di buku besar audit.');">
                <input type="hidden" name="balanceId" value="@b.Id" />
                <input type="hidden" name="redirectLocation" value="@Model.SelectedLocation" />
                <input type="hidden" name="operatorName" value="AUDITOR_WH" />

                <input type="number" name="physicalQty" min="0" value="@b.Quantity" class="form-control form-control-sm text-center fw-bold" style="max-width: 90px;" title="Jumlah fisik terhitung" required />
                <input type="text" name="reason" class="form-control form-control-sm" placeholder="Alasan selisih (rusak/salah hitung)" required />
                <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap d-flex align-items-center gap-1">
                  <i class="bi bi-check2"></i> Simpan
                </button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
