<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - CoreWMS Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-custom sticky-top">
  <div class="container-fluid px-lg-4">
    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
      <div class="brand-icon">
        <i class="bi bi-boxes"></i>
      </div>
      <div>
        <div class="lh-1">CoreWMS</div>
        <div style="font-size: 0.65rem; font-weight: 500; color: #94a3b8; letter-spacing: 0.05em; text-transform: uppercase;">Finished Goods &amp; Dispatch</div>
      </div>
    </a>
    <button class="navbar-toggler border-secondary text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
      <i class="bi bi-list fs-3"></i>
    </button>
    <div class="collapse navbar-collapse" id="navContent">
      <div class="navbar-nav ms-lg-4 gap-1">
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
          <i class="bi bi-grid-1x2-fill"></i> Dashboard
        </a>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Storing" ? "active" : "")" asp-controller="Storing" asp-action="Create">
          <i class="bi bi-box-arrow-in-down"></i> Checksheet Storing
        </a>
        <div class="nav-item dropdown">
          <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Internal" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown">
            <i class="bi bi-arrow-left-right"></i> Operasional Internal
          </a>
          <ul class="dropdown-menu shadow border-0" style="border-radius: 12px; margin-top: 8px;">
            <li><a class="dropdown-item py-2" asp-controller="Internal" asp-action="Transfer"><i class="bi bi-box-arrow-right me-2 text-primary"></i> Relokasi Antar Rak (Bin-to-Bin)</a></li>
            <li><a class="dropdown-item py-2" asp-controller="Internal" asp-action="StockOpname"><i class="bi bi-clipboard-check me-2 text-success"></i> Stock Opname (Cycle Counting)</a></li>
          </ul>
        </div>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dispatch" ? "active" : "")" asp-controller="Dispatch" asp-action="Index">
          <i class="bi bi-truck"></i> Heijunka Dispatch
        </a>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")" asp-controller="Report" asp-action="SubLot">
          <i class="bi bi-file-earmark-bar-graph"></i> Laporan Stok
        </a>
        <div class="nav-item dropdown">
          <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Master" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown">
            <i class="bi bi-gear-wide-connected"></i> Master &amp; Label
          </a>
          <ul class="dropdown-menu shadow border-0" style="border-radius: 12px; margin-top: 8px;">
            <li><a class="dropdown-item py-2" asp-controller="Master" asp-action="Items"><i class="bi bi-boxes me-2 text-primary"></i> Master Produk (SKU)</a></li>
            <li><a class="dropdown-item py-2" asp-controller="Master" asp-action="Locations"><i class="bi bi-geo-alt me-2 text-success"></i> Master Lokasi &amp; Rak</a></li>
            <li><a class="dropdown-item py-2" asp-controller="Master" asp-action="PrintLabels"><i class="bi bi-upc-scan me-2 text-info"></i> Cetak Label QR / Barcode</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item py-2" asp-controller="Master" asp-action="AuditTrail"><i class="bi bi-journal-text me-2 text-warning"></i> Buku Besar Mutasi (Audit Trail)</a></li>
          </ul>
        </div>
      </div>
      <div class="ms-auto d-flex align-items-center gap-3 mt-3 mt-lg-0">
        <div class="system-status-pill">
          <span class="status-dot-pulse"></span>
          <span>WH SYSTEM LIVE</span>
        </div>
      </div>
    </div>
  </div>
</nav>

<main class="container-fluid px-lg-4 py-4">
  @if (TempData["Success"] is string ok)
  {
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert" style="border-radius: 12px; background: #ecfdf5; color: #065f46;">
      <i class="bi bi-check-circle-fill fs-5 text-success"></i>
      <div><strong>Sukses!</strong> @ok</div>
      <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  }
  @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
